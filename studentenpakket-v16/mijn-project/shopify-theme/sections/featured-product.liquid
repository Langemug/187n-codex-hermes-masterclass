{%- assign p = section.settings.product -%}
<section class="wrap" id="drop"><div class="sec-head"><h2>{{ section.settings.heading }}</h2><span>{{ section.settings.meta }}</span></div>
<div class="grid">
  {%- if p != blank -%}
  <a class="card t3" href="{{ p.url }}">
    {%- if section.settings.sticker != blank -%}<span class="sticker">{{ section.settings.sticker }}</span>{%- endif -%}
    <div class="art art-photo">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: p.featured_media.alt | default: p.title }}{%- endif -%}</div>
    <div class="meta"><span>{{ p.title | upcase }}</span><span>{{ p.price | money }}</span></div>
  </a>
  {%- else -%}
  <div class="card t3"><div class="art"><p>Choose a product in the theme editor.</p></div></div>
  {%- endif -%}
  <div class="card t1 feature-card">
    <div class="rule"><s></s><span>Nº</span><b></b></div>
    <h2>{{ section.settings.card_heading }}</h2>
    <p>{{ section.settings.card_text }}</p>
    {%- if p != blank -%}<div><a class="btn p" href="{{ p.url }}">{{ section.settings.card_cta }} · {{ p.price | money }}</a></div>{%- endif -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "DROP 001" },
    { "type": "text", "id": "meta", "label": "Meta line", "default": "ONE HOODIE · THIS EDITION WON'T COME BACK" },
    { "type": "text", "id": "sticker", "label": "Sticker", "default": "FOUNDING MEMBER" },
    { "type": "text", "id": "card_heading", "label": "Card heading", "default": "YOUR NUMBER IS YOUR MEMBERSHIP." },
    { "type": "textarea", "id": "card_text", "label": "Card text", "default": "Opens at a pop-up in Europe. Online seven days later." },
    { "type": "text", "id": "card_cta", "label": "Card button", "default": "JOIN THE SOCIETY" }
  ],
  "presets": [ { "name": "Featured product" } ]
}
{% endschema %}
