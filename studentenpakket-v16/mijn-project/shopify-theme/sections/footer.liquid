<footer class="site-foot"><div class="foot-grid">
  <div class="foot-brand"><a class="brand" href="{{ routes.root_url }}"><img src="{{ 'logo-purple-outline.png' | asset_url }}" alt="" width="34" height="34">{{ shop.name | upcase }}</a><p>{{ section.settings.tagline }}</p></div>
  {%- for block in section.blocks -%}
    <div class="foot-col" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3>
      {%- for link in linklists[block.settings.menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </div>
  {%- endfor -%}
</div><div class="foot-note">© {{ 'now' | date: '%Y' }} {{ shop.name | upcase }} · {{ section.settings.note }}</div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "STAND APART. MOVE TOGETHER." },
    { "type": "text", "id": "note", "label": "Bottom note", "default": "PREVIEW THEME · NOT PUBLISHED" }
  ],
  "blocks": [
    { "type": "column", "name": "Link column", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "SHOP" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ]}
  ],
  "max_blocks": 4,
  "default": { "blocks": [ { "type": "column" } ] }
}
{% endschema %}
