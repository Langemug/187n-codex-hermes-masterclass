{%- comment -%} Maattabel Tapstitch UT0268 (bron: merkdossier). Alleen tonen bij producten met tag 'size-ut0268'. Later naar product-metafield verplaatsen. {%- endcomment -%}
{%- assign cm = "S,61,58.5,57,48|M,63,60.5,59,49|L,65,62.5,61,50|XL,67,64.5,63,51|2XL,69,66.5,65,52" | split: "|" -%}
{%- assign inch = "S,24.02,23.03,22.44,18.90|M,24.80,23.82,23.23,19.29|L,25.59,24.61,24.02,19.68|XL,26.38,25.39,24.80,20.08|2XL,27.17,26.18,25.59,20.47" | split: "|" -%}
<details class="size-guide" id="size-guide"><summary>SIZE GUIDE</summary>
<div class="sg-unit">CM</div><table><tr><th>SIZE</th><th>LENGTH</th><th>SHOULDER</th><th>CHEST</th><th>SLEEVE</th></tr>{%- for r in cm -%}{%- assign c = r | split: ',' -%}<tr><td>{{ c[0] }}</td><td>{{ c[1] }}</td><td>{{ c[2] }}</td><td>{{ c[3] }}</td><td>{{ c[4] }}</td></tr>{%- endfor -%}</table>
<div class="sg-unit">INCHES</div><table><tr><th>SIZE</th><th>LENGTH</th><th>SHOULDER</th><th>CHEST</th><th>SLEEVE</th></tr>{%- for r in inch -%}{%- assign c = r | split: ',' -%}<tr><td>{{ c[0] }}</td><td>{{ c[1] }}</td><td>{{ c[2] }}</td><td>{{ c[3] }}</td><td>{{ c[4] }}</td></tr>{%- endfor -%}</table>
{% render 'measure-diagram' %}
<p class="sg-note">Flat measurements. 1–3 cm difference may occur.<br>1 Length: shoulder seam at collar to hem.<br>2 Shoulder: shoulder seam to shoulder seam.<br>3 Chest: below the armpits, side to side.<br>4 Sleeve: shoulder seam at armhole to cuff.</p></details>
