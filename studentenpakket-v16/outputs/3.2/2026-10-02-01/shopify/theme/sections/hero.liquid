<div class="hero"><div class="stars" aria-hidden="true"></div>
<span class="corner c1"></span><span class="corner c2"></span><span class="corner c3"></span><span class="corner c4"></span>
<div class="content"><div class="box">
  <div class="vs" aria-hidden="true"><img class="vs-base" src="{{ 'logo-white.png' | asset_url }}" alt=""><img class="vs-g vs-g1" src="{{ 'logo-hot.png' | asset_url }}" alt=""><img class="vs-g vs-g2" src="{{ 'logo-white.png' | asset_url }}" alt=""><span class="vs-scan"></span></div>
  <div class="boot">{{ section.settings.boot }}<span>_</span></div>
  <div class="rule"><s></s><span>∞</span><b></b></div>
  <h1>{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h1>
  <div class="dots" aria-hidden="true">{% for i in (1..36) %}<i></i>{% endfor %}</div>
  <p>{{ section.settings.text }}</p>
  <div class="btns">
    {%- if section.settings.cta_label != blank -%}<a class="btn p" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    {%- if section.settings.cta2_label != blank -%}<a class="btn" href="{{ section.settings.cta2_link | default: routes.collections_url }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
  </div>
  <div class="foot"><span>∞</span><b></b><span>MOVE.TOGETHER</span></div>
</div></div>
<div class="status"><div class="bar"><span>{{ section.settings.status }}</span><span style="display:flex;gap:12px;align-items:center"><span class="pulse"><i></i><i></i><i></i></span><span>Nº ____</span></span></div></div>
</div>
{% schema %}
{
  "name": "Hero · Terminal",
  "settings": [
    { "type": "text", "id": "boot", "label": "Boot line", "default": "> SIGNAL ACQUIRED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "STAND" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (purple)", "default": "APART." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Not a brand. A movement. For the 1% who build while the rest talk. Your hoodie number is your member number." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "JOIN THE SOCIETY" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "VIEW THE DROPS" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "status", "label": "Status bar", "default": "SYSTEM.ACTIVE · DROP 001 · V1.0" }
  ],
  "presets": [ { "name": "Hero · Terminal" } ]
}
{% endschema %}
